# CLIENT_ID must match the Application ID in the Discord Developer Portal
# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
BOT_OWNER_IDS=123456789012345678,987654321098765432
BOT_STATUS_CHANNEL_ID=

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional API credentials (referenced by secret_env_key in provider config)
BYPASS_API_KEY=
LINK_UNLOCK_API_KEY=
CUSTOM_API_KEY=

# Runtime
NODE_ENV=production
LOG_LEVEL=info
DEFAULT_TIMEOUT_MS=10000
MAX_RETRIES=2
CACHE_TTL_SECONDS=180
CACHE_MAX_ROWS=2000
STORAGE_CLEANUP_INTERVAL_SECONDS=300
HEALTH_CHECK_INTERVAL_SECONDS=60

# Health thresholds
HEALTHY_SUCCESS_RATE=0.85
DEGRADED_SUCCESS_RATE=0.50
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_MS=60000
CIRCUIT_HALF_OPEN_MAX=2

# Rate limits
RATE_LIMIT_USER_PER_MINUTE=10
RATE_LIMIT_GUILD_PER_MINUTE=30
RATE_LIMIT_AUTOBYPASS_PER_MINUTE=5

# Security
MAX_RESPONSE_SIZE_BYTES=1048576
MAX_REDIRECTS=3
